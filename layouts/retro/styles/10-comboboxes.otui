ComboBoxPopupScrollMenuButton < UIButton
  height: 23
  font: verdana-11px-antialised
  text-align: left
  text-offset: 4 0
  color: #8a837d
  background-color: alpha
  image-source: /images/ui/combobox_square
  image-clip: 0 75 179 25
  image-border: 3
  image-border-left: 7
  margin: 0 1

  $hover !disabled:
    color: #e3cdbb
    background-color: #595959

  $disabled:
    color: #e3cdbb88

ComboBoxPopupScrollMenu < UIPopupScrollMenu
  background-color: #00000033

ComboBoxPopupMenuButton < UIButton
  height: 23
  font: verdana-11px-antialised
  text-align: left
  text-offset: 5 2
  color: #8a837d
  background-color: alpha
  image-source: /images/ui/combobox_square
  image-clip: 0 75 179 25
  image-border: 3
  image-border-left: 7
  margin: 0 1

  $hover !disabled:
    color: #e3cdbb
    background-color: #355d89

  $disabled:
    color: #e3cdbb88

ComboBoxPopupMenu < UIPopupMenu
  background-color: #00000033

ComboBox < UIComboBox
  font: verdana-11px-antialised
  color: #e3cdbb
  size: 91 23
  text-offset: 5 2
  text-align: left
  image-source: /images/ui/combobox_square
  image-border: 3
  image-border-left: 7
  image-border-right: 34
  image-clip: 0 0 179 25

  $hover !disabled:
    image-clip: 0 25 179 25

  $on:
    image-clip: 0 50 179 25

  $disabled:
    color: #e3cdbb88
    opacity: 0.8

ComboBoxRoundedPopupScrollMenuButton < UIButton
  height: 23
  font: verdana-11px-antialised
  text-align: left
  text-offset: 5 2
  color: #e3cdbb
  background-color: alpha

  $hover !disabled:
    color: #ffffff
    background-color: #355d89

  $disabled:
    color: #e3cdbb88

ComboBoxRoundedPopupScrollMenu < UIPopupScrollMenu
  image-source: /images/ui/combobox_rounded
  image-clip: 0 69 91 23
  image-border: 3

ComboBoxRoundedPopupMenuButton < UIButton
  height: 23
  font: verdana-11px-antialised
  text-align: left
  text-offset: 5 2
  color: #e3cdbb
  background-color: alpha

  $hover !disabled:
    color: #ffffff
    background-color: #355d89

  $disabled:
    color: #e3cdbb88

ComboBoxRoundedPopupMenu < UIPopupMenu
  image-source: /images/ui/combobox_rounded
  image-clip: 0 69 91 23
  image-border: 3

ComboBoxRounded < ComboBox
  image-source: /images/ui/combobox_rounded
  image-border: 3
