MiniWindow < UIMiniWindow
  font: verdana-11px-antialised
  color: #eae3da
  icon-rect: 16 13 13 13
  icon-clip: 0 0 20 20
  width: 218
  height: 200
  text-offset: 33 12
  text-align: topLeft
  focusable: false
  &minimizedHeight: 40
  margin-top: 1
  image-source: /images/ui/textures/miniwindow_background
  image-border: 1
  image-border-top: 30

  //$on:
    //image-border-bottom: 2

  UIWidget
    phantom: true
    focusable: false
    image-source: /images/ui/panels/miniwindow
    image-border: 12
    image-border-top: 31
    image-border-right: 37
    image-border-bottom: 33
    anchors.fill: parent

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 0
    margin-left: 3
    margin-top: 3
    height: 42
    phantom: true

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 11
    margin-right: 12
    size: 22 16
    image-source: /images/ui/nav_buttons
    image-clip: 100 0 25 20

    $hover:
      image-clip: 100 20 25 20

    $pressed:
      image-clip: 100 40 25 20

  UIButton
    id: minimizeButton
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 3
    size: 22 16
    image-source: /images/ui/nav_buttons
    image-clip: 25 0 25 20

    $hover:
      image-clip: 25 20 25 20

    $pressed:
      image-clip: 25 40 25 20

    $on:
      image-clip: 50 0 25 20

    $on hover:
      image-clip: 50 20 25 20

    $on pressed:
      image-clip: 50 40 25 20

  UIButton
    id: lockButton
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 2
    size: 22 16
    image-source: /images/ui/nav_buttons
    image-clip: 175 0 25 20

    $hover:
      image-clip: 175 20 25 20

    $pressed:
      image-clip: 175 40 25 20

    $on:
      image-clip: 200 0 25 20

    $on hover:
      image-clip: 200 20 25 20

    $on pressed:
      image-clip: 200 40 25 20

  VerticalScrollBar
    id: miniwindowScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    margin-top: 30
    margin-right: 12
    margin-bottom: 12
    pixels-scroll: true

    $!on:
      width: 0

  UIWidget
    phantom: true
    focusable: false
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    image-source: /images/ui/panels/miniwindow_bottom_deco
    margin-bottom: -2
    size: 222 27

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 10
    minimum: 48
    margin-left: 2
    margin-right: 2
    background: #ffffff88

MiniWindowContents < ScrollablePanel
  id: contentsPanel
  anchors.fill: parent
  anchors.right: miniwindowScrollBar.left
  margin-left: 15
  margin-bottom: 12
  margin-top: 34
  vertical-scrollbar: miniwindowScrollBar

