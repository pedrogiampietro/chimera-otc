InventoryItem < Item
  size: 38 38
  $on:
    image-source: /images/ui/item-blessed

HeadSlot < InventoryItem
  id: slot1
  image-source: /images/game/slots/head
  &position: {x=65535, y=1, z=0}
  $on:
    image-source: /images/game/slots/head-blessed

BodySlot < InventoryItem
  id: slot4
  image-source: /images/game/slots/body
  &position: {x=65535, y=4, z=0}
  $on:
    image-source: /images/game/slots/body-blessed

LegSlot < InventoryItem
  id: slot7
  image-source: /images/game/slots/legs
  &position: {x=65535, y=7, z=0}
  $on:
    image-source: /images/game/slots/legs-blessed

FeetSlot < InventoryItem
  id: slot8
  image-source: /images/game/slots/feet
  &position: {x=65535, y=8, z=0}
  $on:
    image-source: /images/game/slots/feet-blessed

NeckSlot < InventoryItem
  id: slot2
  image-source: /images/game/slots/neck
  &position: {x=65535, y=2, z=0}
  $on:
    image-source: /images/game/slots/neck-blessed

LeftSlot < InventoryItem
  id: slot6
  image-source: /images/game/slots/left-hand
  &position: {x=65535, y=6, z=0}
  $on:
    image-source: /images/game/slots/left-hand-blessed

FingerSlot < InventoryItem
  id: slot9
  image-source: /images/game/slots/finger
  &position: {x=65535, y=9, z=0}
  $on:
    image-source: /images/game/slots/finger-blessed

BackSlot < InventoryItem
  id: slot3
  image-source: /images/game/slots/back
  &position: {x=65535, y=3, z=0}
  $on:
    image-source: /images/game/slots/back-blessed

RightSlot < InventoryItem
  id: slot5
  image-source: /images/game/slots/right-hand
  &position: {x=65535, y=5, z=0}
  $on:
    image-source: /images/game/slots/right-hand-blessed

AmmoSlot < InventoryItem
  id: slot10
  image-source: /images/game/slots/ammo
  &position: {x=65535, y=10, z=0}
  $on:
    image-source: /images/game/slots/ammo-blessed

PurseButton < UIButton
  id: purseButton
  size: 34 12
  !tooltip: tr('Open purse')
  icon-source: /images/game/slots/purse
  icon-clip: 0 0 34 12
  
  $on:
    icon-clip: 0 12 34 12

  $pressed:
    icon-clip: 0 12 34 12

CombatBox < UICheckBox
  size: 24 24

InventoryButton < Button
  image-size: 59 26
  padding-left: 6
  @onClick: modules.game_hotkeys.toggle()
  !text: tr('Hotkeys')
  font: verdana-11px-rounded
  text-offset: 2 8
  margin-top: 2
  text-align: center
  font: cipsoftFont
  color: white
  size: 45 18

  $pressed:
    text-offset: 2 8

SoulCapLabel < GameLabel
  text-align: center
  color: #FFFFFF
  font: cipsoftFont
  margin-top: 4
  text-offset: 0 3
  width: 36
  height: 20
  icon-source: /images/game/slots/soulcap
      
FightOffensiveBox < CombatBox
  image-source: /images/ui/inventory/stance_icons
  image-clip: 0 0 28 28
  $hover:
    image-clip: 0 28 28 28
  $checked:
    image-clip: 0 56 28 28
FightBalancedBox < CombatBox
  image-source: /images/ui/inventory/stance_icons
  image-clip: 28 0 28 28
  $hover:
    image-clip: 28 28 28 28
  $checked:
    image-clip: 28 56 28 28
FightDefensiveBox < CombatBox
  image-source: /images/ui/inventory/stance_icons
  image-clip: 56 0 28 28
  $hover:
    image-clip: 56 28 28 28
  $checked:
    image-clip: 56 56 28 28
ChaseModeBoxStand < CombatBox
  image-source: /images/ui/inventory/stance_icons
  image-clip: 84 0 28 28
  $hover:
    image-clip: 84 28 28 28
  $checked:
    image-clip: 84 56 28 28
ChaseModeBoxRun < CombatBox
  image-source: /images/ui/inventory/stance_icons
  image-clip: 112 0 28 28
  $hover:
    image-clip: 112 28 28 28
  $checked:
    image-clip: 112 56 28 28
SafeFightBox < CombatBox
  image-source: /images/ui/inventory/stance_icons
  image-clip: 140 0 28 28
  $hover:
    image-clip: 140 28 28 28
  $checked:
    image-clip: 140 56 28 28

MountButton < CombatBox
  image-source: /images/game/combatmodes/mount    

InventoryWindow < DragonMiniWindow
  height: 253
  id: inventoryWindow
  @onClose: modules.game_inventory.onMiniWindowClose()
  @onMinimize: modules.game_inventory.onMinimize()
  @onMaximize: modules.game_inventory.onMaximize()
  &save: true
  &autoOpen: 3
  padding-right: 1

  MiniWindowContents
    margin-left: 10
    margin-top: 0
    anchors.left: parent.left
        
    Panel
      padding-right: -1
      id: inventoryPanel
      margin-right: 64
      margin-top: 43
      anchors.fill: parent
      
      HeadSlot
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 1

      BodySlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 5

      LegSlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 5

      FeetSlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 5

      NeckSlot
        anchors.top: slot1.top
        anchors.right: slot1.left
        margin-top: 13
        margin-right: 5

      LeftSlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 5

      FingerSlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 5
        
      BackSlot
        anchors.top: slot1.top
        anchors.left: slot1.right
        margin-top: 13
        margin-left: 5

      RightSlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 5

      AmmoSlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 5

      SoulCapLabel
        !text: tr('Soul')..':'
        color: #a89983
        icon-source: /images/ui/inventory/capacity_box
        icon-border: 2
        text-offset: 0 -8
        icon-width: 38
        icon-height: 35
        margin-top: 1
        width: 38
        anchors.top: slot9.bottom
        anchors.horizontalCenter: slot9.horizontalCenter

      SoulCapLabel
        id: soulLabel
        color: #e3cdbb
        icon-source: /images/ui/noimage
        margin-top: 8
        width: 38
        anchors.top: slot9.bottom
        anchors.horizontalCenter: slot9.horizontalCenter
        
      UIWidget
        text-align: center
        color: #e3cdbb
        font: cipsoftFont
        margin-top: 1
        text-offset: 0 0
        width: 100
        height: 35
        image-source: /images/ui/inventory/capacity_box
        image-width: 100
        image-height: 35
        id: capLabel
        anchors.top: slot10.bottom
        anchors.left: slot10.left
        margin-left: -3

        UIWidget
          width: 46
          height: 12
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          image-source: /images/ui/inventory/label_capacity
          margin-top: 0

      PurseButton
        anchors.left: slot3.left
        anchors.bottom: slot3.top        
        margin-bottom: 3
        
    Panel
      margin-top: 54
      anchors.fill: parent
      anchors.left: prev.right

      UIWidget
        phantom: true
        focusable: false
        image-source: /images/ui/inventory/seperator_vertical
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 13
        margin-left: 29
        height: 75

      UIWidget
        phantom: true
        focusable: false
        image-source: /images/ui/inventory/seperator_horizontal
        anchors.top: parent.top
        anchors.left: parent.left
        width: 48
        margin-top: 36
        margin-left: 6

      UIWidget
        phantom: true
        focusable: false
        image-source: /images/ui/inventory/seperator_horizontal
        anchors.top: parent.top
        anchors.left: parent.left
        width: 45
        margin-top: 63
        margin-left: 6

      UIWidget
        phantom: true
        focusable: false
        image-source: /images/ui/inventory/label_options
        anchors.top: parent.top
        anchors.left: parent.left
        size: 44 12
        margin-left: 7
        
      FightOffensiveBox
        id: fightOffensiveBox
        anchors.left: parent.left
        anchors.top: prev.bottom 
        margin-top: 2    
        margin-left: 4

      ChaseModeBoxStand
        id: chaseStandBox
        anchors.left: prev.right
        anchors.top: prev.top
        margin-left: 4

      FightBalancedBox
        id: fightBalancedBox
        margin-top: 26
        anchors.left: fightOffensiveBox.left
        anchors.top: prev.top

      ChaseModeBoxRun
        id: chaseRunBox
        anchors.left: prev.right
        anchors.top: prev.top
        margin-left: 4

      FightDefensiveBox
        id: fightDefensiveBox
        margin-top: 26
        anchors.left: fightBalancedBox.left
        anchors.top: prev.top
        
      SafeFightBox
        id: safeFightBox
        anchors.left: prev.right
        anchors.top: prev.top
        margin-left: 4
        
      MountButton
        id: mountButton
        anchors.left: prev.right
        anchors.top: prev.top
        
      Panel
        id: buttonsPanel
        margin-top: 4
        margin-right: 5
        anchors.fill: parent
        anchors.top: prev.bottom
        layout:
          type: verticalBox
        
        UIButton
          visible: false
          id: buttonPvp
          height: 20
          icon: /images/game/combatmodes/pvp
          icon-clip: 0 0 42 20

          $on:
            icon-clip: 0 20 42 20
        
        InventoryButton
          visible: false
          !text: tr('Stop')
          @onClick: g_game.stop(); g_game.cancelAttackAndFollow()

        InventoryButton
          visible: false
          image-size: 59 26
          padding-left: 6
          padding-top: 8
          @onClick: modules.client_options.toggle()

          UIWidget
            image-source: /images/ui/inventory/label_settings
            image-size: 48 11

        InventoryButton
          image-size: 59 26
          padding-left: 6
          @onClick: modules.game_hotkeys.toggle()
          !text: tr('Hotkeys')
          font: verdana-11px-rounded
          text-offset: 2 8
          color: #e3cdbb

        InventoryButton
          visible: false
          !text: tr('Logout')
          @onClick: modules.game_interface.tryLogout()
  
  Panel
    image-source: /images/ui/inventory/conditions
    image-border: 5
    id: conditionPanel
    layout:
      type: horizontalBox
    height: 29
    margin: 12 11
    margin-left: 10
    padding: 7
    padding-left: 6
    padding-right: 6
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    background-color: #ffffff22
    visible: true
    $on:
      visible: false

  UIWidget
    phantom: true
    focusable: false
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    image-source: /images/ui/panels/window_bottom_deco
    margin-bottom: -2
    size: 222 27

