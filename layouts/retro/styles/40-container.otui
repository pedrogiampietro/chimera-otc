PageButton < Button
  size: 30 18
  margin: 1


ContainerWindow < MiniWindow
  height: 150
  &save: true
  &containerWindow: true

  UIItem
    id: containerItemWidget
    virtual: true
    size: 15 15
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 12
    margin-left: 16

  UIButton
    id: upButton
    anchors.top: lockButton.top
    anchors.right: lockButton.left
    margin-right: 3
    size: 22 16
    image-source: /images/ui/nav_buttons
    image-clip: 125 0 25 20

    $hover:
      image-clip: 125 20 25 20

    $pressed:
      image-clip: 125 40 25 20

  Panel
    id: pagePanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: miniwindowTopBar.bottom
    margin: 1 3 0 3
    background: #00000066
    height: 20
    
    $on:
      visible: true

    $!on:
      visible: false

    Label
      id: pageLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      text-auto-resize: true

    PageButton
      id: prevPageButton
      text: <
      anchors.top: parent.top
      anchors.left: parent.left

    PageButton
      id: nextPageButton
      text: >
      anchors.top: parent.top
      anchors.right: parent.right

  MiniWindowContents
    padding-right: 0
    layout:
      type: grid
      cell-spacing: 1
      cell-size: 34 34
      flow: true
