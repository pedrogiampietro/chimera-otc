@import /ui/main
@import styles/main

TaskLabel < Label
  font: verdana-11px-monochrome
  text-offset: 20 0
  focusable: true
  height: 30
  background-color: alpha
  icon-source: /images/game/tasks/task_icon
  icon-rect: 0 0 16 16
  icon-offset: 2 7
  text-offset: 24 7
  color: #aaaaaa

  $focus:
    background-color: #444444
    color: #ffffff

  $!focus:
    background-color: alpha

  $recommended:
    text-color: #00ff00

Window < UIWidget
  font: verdana-11px-monochrome
  size: 0 0
  text-offset: 0 4
  text-align: top
  image-source: /images/ui/window
  image-border: 6
  padding: 6
  opacity: 1.0

  $disabled:
    color: #aaaaaa88
    opacity: 0.8

  $dragging:
    opacity: 0.8

TasksWindow < Window
  id: tasksWindow
  !text: tr('Tasks')
  size: 650 450
  padding: 10
  @onEscape: self:destroy()

  Panel
    id: mainPanel
    anchors.fill: parent
    layout: verticalBox

    Panel
      id: leftPanel
      height: 400
      margin-right: 10
      layout: verticalBox
      
      Label
        id: searchHeader
        !text: tr('Search by monster name')
        height: 20
        text-align: center
        
      TextEdit
        id: searchText
        height: 30
        margin-bottom: 10
        @onTextChange: modules.game_tasks.filterTasks()

      Panel
        id: taskList
        height: 340
        margin-right: 5
        layout: verticalBox
        
        VerticalScrollBar
          id: taskListScrollBar
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.right: parent.right
          step: 30
          pixels-scroll: true

    Panel
      id: rightPanel
      height: 400
      layout: verticalBox

      Label
        id: rewardsHeader
        !text: tr('Base Rewards')
        height: 20
        text-align: center

      Panel
        id: rewardsPanel
        height: 120
        margin: 5
        layout: verticalBox

        Label
          id: taskPointsLabel
          !text: tr('Tasks Points: 1')
          margin-bottom: 5
          
        Label
          id: experienceLabel
          !text: tr('Experience: 1000')
          margin-bottom: 5
          
        Label
          id: goldLabel
          !text: tr('Gold: 500')
          margin-bottom: 5
          
        Label
          id: itemsLabel
          !text: tr('Is burning heart')
          margin-bottom: 5
          
        Label
          id: accessLabel
          !text: tr('Access to new hunting area')
          margin-bottom: 5
          
        Label
          id: teleportLabel
          !text: tr('Teleport to Troll Boss fight')
          margin-bottom: 5

      Label
        id: monstersHeader
        !text: tr('Monsters')
        height: 20
        text-align: center
        margin-top: 10

      Panel
        id: monstersPanel
        height: 80
        margin: 5

      Label
        id: killsHeader
        !text: tr('Required Kills')
        height: 20
        text-align: center
        margin-top: 10

      Panel
        id: killsPanel
        height: 60
        margin: 5

        Label
          id: killsRequired
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          margin-top: 5
          text-align: center
          !text: tr('100')

        ProgressBar
          id: killsProgress
          anchors.top: killsRequired.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 5
          margin-left: 50
          margin-right: 50
          background-color: #222222
          height: 10
          
        Label
          id: bonusLabel
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: killsProgress.bottom
          margin-top: 5
          !text: tr('No Bonuses')
          text-align: center

      Button
        id: startTaskButton
        !text: tr('Start Task')
        width: 200
        height: 35
        margin-top: 10
        @onClick: modules.game_tasks.startTask()

    HorizontalSeparator
      id: bottomSeparator
      height: 2
      margin-top: 10
      margin-bottom: 10

    Panel
      id: bottomPanel
      height: 30
      layout: horizontalBox

      Label
        id: currentTaskPoints
        text-auto-resize: true
        !text: tr('Current Tasks Points: 0')

      Button
        id: closeButton
        !text: tr('Close')
        width: 90
        @onClick: self:getParent():getParent():destroy() 