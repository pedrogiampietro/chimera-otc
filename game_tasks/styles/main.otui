UIWidget
  font: verdana-11px-monochrome

UIButton < UIWidget
  font: verdana-11px-monochrome
  color: #dfdfdf
  size: 106 23
  text-offset: 0 0
  image-source: /images/ui/button
  image-color: #dfdfdf
  image-clip: 0 0 22 23
  image-border: 3
  padding: 5 10 5 10
  opacity: 1.0

  $hover !disabled:
    image-clip: 0 23 22 23

  $pressed:
    image-clip: 0 46 22 23
    text-offset: 1 1

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

Button < UIButton
  height: 23
  text-align: center

Label < UIWidget
  font: verdana-11px-monochrome

Panel < UIWidget
  phantom: true

TextEdit < UIWidget
  font: verdana-11px-monochrome
  color: #aaaaaa
  size: 86 20
  text-offset: 3 3
  padding: 3
  text-align: left
  image-source: /images/ui/textedit
  image-border: 1
  selection-color: #111416
  selection-background-color: #999999
  $disabled:
    color: #aaaaaa88
    opacity: 0.8

  $!editable:
    color: #aaaaaa88
    opacity: 0.8

ProgressBar < UIProgressBar
  height: 10
  background-color: #222222
  border: 1 black
  margin: 1

  image-source: /images/ui/progressbar
  image-border: 1

HorizontalSeparator < UIWidget
  image-source: /images/ui/separator_horizontal
  image-border: 2
  height: 2
  virtual: true
  margin: 3 0

VerticalScrollBar < UIScrollBar
  orientation: vertical
  width: 14
  height: 10
  button-size: 14
  step: 14
  image-source: /images/ui/scrollbar
  image-repeated: true
  image-border: 1
  image-border-top: 2
  image-border-bottom: 2
  pixels-scroll: true

  $hover:
    image-clip: 14 0 14 10

  $pressed:
    image-clip: 28 0 14 10

  $disabled:
    color: #dfdfdf88
    opacity: 0.8 