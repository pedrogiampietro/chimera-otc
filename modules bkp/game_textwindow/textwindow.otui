TextWindow < MainWindowBorderless
  id: textWindow
  size: 308 284
  //padding-top: 45
  //padding-right: 26
  padding-top: 0
  padding-right: 0
  text-offset: 34 18

  WindowBorders
    margin: 0
    margin-left: -21
    margin-bottom: -16

  Item
    id: textItem
    image-source: /images/ui/noimage
    virtual: true
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 56
    margin-right: 22

  Item
    id: textItemTitle
    image-source: /images/ui/noimage
    virtual: true
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 18
    margin-left: -6
    size: 16 16

  Panel
    anchors.fill: parent
    padding-top: 45
    padding-right: 26

    Label
      id: description
      color: #e3cdbb
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-left: 4
      margin-right: 8
      text-auto-resize: true
      text-align: left
      text-wrap: true

    MultilineTextEdit
      id: text
      padding: 10
      anchors.top: textScroll.top
      anchors.left: parent.left
      anchors.right: textScroll.left
      anchors.bottom: textScroll.bottom
      vertical-scrollbar: textScroll
      text-wrap: true

    VerticalScrollBar
      id: textScroll
      anchors.top: description.bottom
      anchors.bottom: okButton.top
      anchors.right: parent.right
      margin-top: 10
      margin-bottom: 5
      step: 16
      pixels-scroll: true

    Button
      id: okButton
      !text: tr('Ok')
      color: #eae3da
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-right: 3
      size: 63 26

  UIButton
    id: cancelButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 16
    margin-right: 22
    size: 22 16
    image-source: /images/ui/nav_buttons
    image-clip: 100 0 25 20

    $hover:
      image-clip: 100 20 25 20

    $pressed:
      image-clip: 100 40 25 20

  //Button
  //  id: cancelButton
  //  !text: tr('Cancel')
  //  anchors.bottom: parent.bottom
  //  anchors.right: parent.right
  //  width: 60
