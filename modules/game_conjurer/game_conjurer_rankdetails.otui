MainWindow
  id: rankDetailsWindow
  !text: tr('Rank Details')
  size: 520 550
  draggable: true
  modal: true
  @onEscape: self:destroy()
  
  UIWidget
    id: rankDetailsContent
    layout:
      type: verticalBox
      spacing: 10
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: rankDetailsBackButton.top
    margin: 18
    margin-bottom: 10
    
    UIWidget
      id: rankDetailsHeader
      layout:
        type: horizontalBox
        spacing: 12
      height: 56
      
      UIWidget
        id: rankDetailsIcon
        width: 48
        height: 48
        image-smooth: true
        border-width: 2
        border-color: #ffaa00
        margin-top: 4
        margin-bottom: 4
      Label
        id: rankDetailsName
        font: verdana-11px-rounded
        color: #ffaa00
        text: ''
        margin-top: 14
        margin-left: 8
        text-auto-resize: true
    
    Label
      id: rankDetailsDesc
      font: verdana-11px-rounded
      color: #cccccc
      text: ''
      text-wrap: true
      width: 320
      margin-bottom: 2

    Label
      !text: tr('Slots de Gemas:')
      font: verdana-11px-rounded
      color: #a1e65b
      margin-top: 10

    UIWidget
      id: gem_slot_container
      height: 70
      margin-top: 5
      
      Label
        id: gemSlotsInfo
        !text: tr('Aplique gemas para receber bônus')
        font: verdana-11px-rounded
        color: #cccccc
        anchors.left: parent.left
        anchors.top: parent.top
        margin-top: 2
        text-wrap: true
        width: 400
    
      UIWidget
        id: gem_slot_box1
        size: 50 50
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 50
        margin-top: 25
        background-color: #333333
        border-width: 2
        border-color: #666666
        
        UIItem
          id: gemSlot1
          size: 36 36
          anchors.left: parent.left
          anchors.top: parent.top
          margin-left: 7
          margin-top: 7
          virtual: true
          image-source: /images/ui/item-blessed
          opacity: 0.5
          image-color: #aaaaaa
          
        Label
          id: gemSlot1_label
          !text: tr('Slot 1')
          font: verdana-11px-rounded
          color: #888888
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.bottom: parent.bottom
          margin-bottom: -18
          
      UIWidget
        id: gem_slot_box2
        size: 50 50
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        margin-top: 25
        background-color: #333333
        border-width: 2
        border-color: #666666
        
        UIItem
          id: gemSlot2
          size: 36 36
          anchors.left: parent.left
          anchors.top: parent.top
          margin-left: 7
          margin-top: 7
          virtual: true
          image-source: /images/ui/item-blessed
          opacity: 0.5
          image-color: #aaaaaa
          
        Label
          id: gemSlot2_label
          !text: tr('Slot 2')
          font: verdana-11px-rounded
          color: #888888
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.bottom: parent.bottom
          margin-bottom: -18
          
      UIWidget
        id: gem_slot_box3
        size: 50 50
        anchors.right: parent.right
        anchors.top: parent.top
        margin-right: 50
        margin-top: 25
        background-color: #333333
        border-width: 2
        border-color: #666666
        
        UIItem
          id: gemSlot3
          size: 36 36
          anchors.left: parent.left
          anchors.top: parent.top
          margin-left: 7
          margin-top: 7
          virtual: true
          image-source: /images/ui/item-blessed
          opacity: 0.5
          image-color: #aaaaaa
          
        Label
          id: gemSlot3_label
          !text: tr('Slot 3')
          font: verdana-11px-rounded
          color: #888888
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.bottom: parent.bottom
          margin-bottom: -18

    Label
      id: rankGemsEffects
      !text: tr('Efeitos Ativos: Nenhuma gema equipada')
      font: verdana-11px-rounded
      color: #ffaa00
      margin-top: 5
      text-wrap: true
      width: 400

    Label
      !text: tr('Gemas Disponíveis:')
      font: verdana-11px-rounded
      color: #a1e65b
      margin-top: 10

    UIWidget
      id: available_gems_container
      height: 130
      margin-top: 5
      background-color: #1a1a1a
      border-width: 1
      border-color: #666666
      clipping: true
      
      ScrollablePanel
        id: availableGemsPanel
        anchors.fill: parent
        margin: 6
        clipping: true
        layout:
          type: grid
          cell-size: 62 62
          cell-spacing: 4
          num-columns: 6

  Button
    id: rankDetailsBackButton
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 15
    margin-bottom: 15
    text: "Back"
    width: 90
    height: 30
    font: verdana-11px-rounded
    @onClick: self:getParent():destroy()
    
  Button
    id: rankDetailsCloseButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 15
    margin-bottom: 15
    text: "Close"
    width: 90
    height: 30
    font: verdana-11px-rounded
    @onClick: self:getParent():destroy() 