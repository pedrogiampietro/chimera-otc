MainWindow
  id: rankDetailsWindow
  !text: tr('Rank Details')
  size: 520 550
  draggable: true
  modal: true
  @onEscape: self:destroy()
  
  UIWidget
    id: rankDetailsContent
    layout:
      type: verticalBox
      spacing: 10
    anchors.fill: parent
    margin: 18
    
    UIWidget
      id: rankDetailsHeader
      layout:
        type: horizontalBox
        spacing: 12
      height: 56
      
      UIWidget
        id: rankDetailsIcon
        width: 48
        height: 48
        image-smooth: true
        border-width: 2
        border-color: #ffaa00
        margin-top: 4
        margin-bottom: 4
      Label
        id: rankDetailsName
        font: verdana-11px-rounded
        color: #ffaa00
        text: ''
        margin-top: 14
        margin-left: 8
        text-auto-resize: true
    
    Label
      id: rankDetailsDesc
      font: verdana-11px-rounded
      color: #cccccc
      text: ''
      text-wrap: true
      width: 320
      margin-bottom: 2
    
    Label
      id: rankDetailsDate
      font: verdana-11px-rounded
      color: #888888
      text: ''
      margin-top: 2
    
    Label
      id: rankDetailsRequirement
      font: verdana-11px-rounded
      color: #e65b5b
      text: ''
      margin-top: 2

    Label
      !text: tr('Slots de Gemas do Rank:')
      font: verdana-11px-rounded
      color: #a1e65b
      margin-top: 20

    UIWidget
      id: gem_slot_container
      height: 80
      margin-top: 5
      
      Label
        id: gemSlotsInfo
        !text: tr('Aplique gemas para receber bônus nas runas/magias deste rank')
        font: verdana-11px-rounded
        color: #cccccc
        anchors.left: parent.left
        anchors.top: parent.top
        margin-top: 2
        text-wrap: true
        width: 400
    
      UIWidget
        id: gem_slot_box1
        size: 50 50
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 50
        margin-top: 25
        background-color: #333333
        border-width: 2
        border-color: #666666
        
        UIItem
          id: gemSlot1
          size: 36 36
          anchors.left: parent.left
          anchors.top: parent.top
          margin-left: 7
          margin-top: 7
          virtual: true
          image-source: /images/ui/item-blessed
          opacity: 0.5
          image-color: #aaaaaa
          
        Label
          id: gemSlot1_label
          !text: tr('Slot 1')
          font: verdana-11px-rounded
          color: #888888
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.bottom: parent.bottom
          margin-bottom: -18
          
      UIWidget
        id: gem_slot_box2
        size: 50 50
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        margin-top: 25
        background-color: #333333
        border-width: 2
        border-color: #666666
        
        UIItem
          id: gemSlot2
          size: 36 36
          anchors.left: parent.left
          anchors.top: parent.top
          margin-left: 7
          margin-top: 7
          virtual: true
          image-source: /images/ui/item-blessed
          opacity: 0.5
          image-color: #aaaaaa
          
        Label
          id: gemSlot2_label
          !text: tr('Slot 2')
          font: verdana-11px-rounded
          color: #888888
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.bottom: parent.bottom
          margin-bottom: -18
          
      UIWidget
        id: gem_slot_box3
        size: 50 50
        anchors.right: parent.right
        anchors.top: parent.top
        margin-right: 50
        margin-top: 25
        background-color: #333333
        border-width: 2
        border-color: #666666
        
        UIItem
          id: gemSlot3
          size: 36 36
          anchors.left: parent.left
          anchors.top: parent.top
          margin-left: 7
          margin-top: 7
          virtual: true
          image-source: /images/ui/item-blessed
          opacity: 0.5
          image-color: #aaaaaa
          
        Label
          id: gemSlot3_label
          !text: tr('Slot 3')
          font: verdana-11px-rounded
          color: #888888
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.bottom: parent.bottom
          margin-bottom: -18

    Label
      id: rankGemsEffects
      !text: tr('Efeitos Ativos: Nenhuma gema equipada')
      font: verdana-11px-rounded
      color: #ffaa00
      margin-top: 10
      text-wrap: true
      width: 400

    Label
      !text: tr('Gemas do Inventário:')
      font: verdana-11px-rounded
      color: #a1e65b
      margin-top: 15
      
    Label
      id: gemsInventoryInfo
      !text: tr('Arraste as gemas abaixo para os slots verdes para equipá-las')
      font: verdana-11px-rounded
      color: #ffaa00
      margin-top: 2
      text-wrap: true
      width: 400

    UIWidget
      id: available_gems_container
      height: 110
      margin-top: 5
      background-color: #1a1a1a
      border-width: 1
      border-color: #666666
      clipping: true
      
      ScrollablePanel
        id: availableGemsPanel
        anchors.fill: parent
        margin: 6
        clipping: true
        layout:
          type: grid
          cell-size: 62 62
          cell-spacing: 4
          num-columns: 6

    UIWidget
      id: rankDetailsButtonRow
      layout:
        type: horizontalBox
        spacing: 8
      margin-top: 10
      Button
        id: rankDetailsHelpButton
        text: '?'
        font: verdana-11px-rounded
        width: 28
        height: 28
        tooltip: tr('Sobre ranks')
        @onClick: rankDetailsHelp()
      Button
        id: rankDetailsCloseButton
        text: tr('Fechar')
        font: verdana-11px-rounded
        width: 90
        height: 28
        @onClick: self:getParent():getParent():getParent():destroy() 