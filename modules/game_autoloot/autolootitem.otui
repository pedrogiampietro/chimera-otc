AutoLootListRow < Panel
  id: autoLootRow
  height: 36
  width: 250
  background-color: #222222cc
  border-width: 1
  border-color: #444444
  margin: 2
  layout: horizontalBox

  UIWidget
    id: itemImage
    width: 32
    height: 32
    margin: 2
    border-width: 1
    border-color: #666666
    background: #333333
    image-source: ""

  UILabel
    id: itemLabel
    margin-left: 8
    text: ""
    font: verdana-11px-rounded
    color: #FFD700
    text-align: left
    vertical-align: center
    width: 150

  UIButton
    id: removeButton
    text: "×"
    width: 28
    height: 28
    margin-left: 20
    margin-right: 4
    margin-top: 4
    background-color: #ff3333
    border-width: 1
    border-color: #ff6666
    color: #ffffff
    font: verdana-11px-rounded
    font-size: 16
    tooltip: "Remover item"
    visible: true
    enabled: true
    hover-background-color: #ff5555
    pressed-background-color: #ff1111