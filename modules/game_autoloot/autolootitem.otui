AutoLootListRow < Panel
  id: autoLootRow
  height: 36
  width: 250
  background-color: #222222cc
  border-width: 1
  border-color: #444444
  margin: 2
  layout: horizontalBox
  padding-top: 0
  padding-bottom: 0

  UIWidget
    id: itemImage
    width: 32
    height: 32
    margin: 2
    border-width: 1
    border-color: #666666
    background: #333333
    image-source: ""

  UILabel
    id: itemLabel
    margin-left: 8
    text: ""
    font: verdana-11px-rounded
    color: #FFD700
    text-align: left
    vertical-align: center
    width: 150

  UIButton
    id: removeButton
    width: 60
    height: 22
    margin-left: 12
    margin-right: 8
    text: "X"
    font: verdana-11px-rounded
    font-size: 12
    tooltip: "Remove item"
    visible: true
    enabled: true