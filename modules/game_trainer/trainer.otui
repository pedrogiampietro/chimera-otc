TrainerAddSpell < MainWindow
  id: TrainerAddSpell
  size: 275 100
  text: Edit Spell

  TextEdit
    id: text
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5

  Button
    id: buttonClose
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 45 21
    text: Close

  Button
    id: buttonOk
    anchors.right: prev.left
    margin-right: 5
    anchors.bottom: parent.bottom
    size: 45 21
    text: Save

TrainerAddPercent < MainWindow
  id: TrainerAddPercent
  size: 275 100
  text: Edit Mana Percentage

  TextEdit
    id: text
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    max-length: 3

  Button
    id: buttonClose
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 45 21
    text: Close

  Button
    id: buttonOk
    anchors.right: prev.left
    margin-right: 5
    anchors.bottom: parent.bottom
    size: 45 21
    text: Save
    
TrainerCheckBox < CheckBox
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: prev.bottom
  height: 16
  margin: 10 10 0 5
  @onCheckChange: modules.game_trainer.setOption(self:getId(), self:isChecked())

TrainerTextEdit < TextEdit
  anchors.left: parent.left
  anchors.top: prev.bottom
  width: 100
  margin: 0 5 0 5
  @onClick: modules.game_trainer.inputSpell(self:getId())

TrainerPercentEdit < TextEdit
  anchors.top: prev.top
  anchors.left: prev.right
  width: 50
  margin: 0 3 0 3
  text-align: center
  editable: false
  @onClick: modules.game_trainer.inputPercent(self:getId())

TrainerPercentLabel < Label
  anchors.top: prev.top
  anchors.left: prev.right
  anchors.right: parent.right
  margin: 3 5 0 0
  text: %
  text-align: left
    
MiniWindow
  id: trainerWindow
  !text: tr('Trainer')
  height: 190
  icon: /images/topButtons/inventory
  @onClose: modules.game_trainer.onMiniWindowClose()
  &save: true
  &autoOpen: 11

  MiniWindowContents
    Button
      id: enableButton
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 5
      @onClick: modules.game_trainer.toggle()
      
      $on:
        text: Trainer ON
        color: #00AA00
        
      $!on:
        text: Trainer OFF
        color: #FF0000

    TrainerCheckBox
      id: checkMT
      !text: tr('Mana Training')

    TrainerTextEdit
      id: spellMT
      !text: tr('spell')

    TrainerPercentEdit
      id: manaMT

    TrainerPercentLabel

    TrainerCheckBox
      id: checkRM
      !text: tr('Rune Maker')

    TrainerTextEdit
      id: spellRM
      !text: tr('spell')

    TrainerPercentEdit
      id: manaRM

    TrainerPercentLabel

    TrainerCheckBox
      id: checkIdle
      text: Anti-Idle

    TrainerCheckBox
      id: checkFood
      text: Auto-Eat Food
      margin-top: 3