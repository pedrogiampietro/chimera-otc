TaskLabel < Label
  font: verdana-11px-monochrome
  focusable: true
  height: 50
  margin-top: 2
  margin-bottom: 2
  padding: 5
  background-color: alpha
  icon-size: 40 40
  icon-rect: 0 0 40 40
  icon-offset: 5 5
  text-offset: 50 15
  color: #aaaaaa

  $focus:
    background-color: #444444
    color: #ffffff

  $!focus:
    background-color: alpha

  $recommended:
    text-color: #00ff00

  $daily:
    text-color: #ffcc00

TaskSectionHeader < Label
  height: 25
  background-color: #222222
  text-align: center
  font: verdana-11px-rounded
  color: #ffcc00
  margin-top: 5
  margin-bottom: 5
  border: 1 #444444

TaskContainer < Panel
  layout: verticalBox
  layout-spacing: 2
  padding: 2

TaskPanel < UIWidget
  height: 60
  background-color: alpha
  padding: 5
  margin-bottom: 2
  
  UIWidget
    id: taskIcon
    size: 48 48
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    
  Label
    id: taskName
    text: Task Name
    anchors.left: taskIcon.right
    anchors.top: taskIcon.top
    margin-left: 10
    width: 180
    text-wrap: false
    phantom: true
    color: #ffffff
    font: verdana-11px-monochrome
    
  Label
    id: taskLevel
    text: Level 8
    anchors.left: taskIcon.right
    anchors.top: taskName.bottom
    margin-left: 10
    margin-top: 2
    phantom: true
    color: #888888
    font: verdana-11px-monochrome
    
  Label
    id: recommendedTag
    text: Recommended
    anchors.left: taskIcon.right
    anchors.top: taskLevel.bottom
    margin-left: 10
    margin-top: 2
    phantom: true
    color: #00ff00
    font: verdana-11px-monochrome
    visible: false
    
  $hover:
    background-color: #444444
    
  $focus:
    background-color: #555555
    
  $selected:
    background-color: #666666
    
TaskContainer < ScrollablePanel
  layout:
    type: verticalBox
    spacing: 2

TasksWindow < MainWindow
  id: tasksWindow
  !text: tr('Tasks')
  size: 800 600
  @onEscape: self:hide()
  @onEnter: self:hide()
  
  // Main panel with dark background
  Panel
    id: mainPanel
    anchors.fill: parent
    margin: 3
    background-color: #202020ee
    border: 1 #333333
    
    // Search field
    TextEdit
      id: searchText
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      margin-left: 10
      margin-right: 10
      height: 25
      !text: tr('Search by monster name')
      background-color: #111111
      color: #aaaaaa
      font: verdana-11px-rounded
      padding: 5
      border: 1 #444444
      @onTextChange: modules.game_tasks.filterTasks()
      
    // Task list panel with scroll
    Panel
      id: taskListPanel
      anchors.top: searchText.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-top: 10
      margin-left: 10
      width: 350
      background-color: #151515ee
      border: 1 #333333
      
      ScrollablePanel
        id: taskList
        anchors.fill: parent
        margin: 2
        vertical-scrollbar: taskListScrollBar
        layout:
          type: verticalBox
          spacing: 2
          
      VerticalScrollBar
        id: taskListScrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        step: 14
        pixels-scroll: true
      
    // Details panel
    Panel
      id: detailsPanel
      anchors.top: searchText.bottom
      anchors.left: taskListPanel.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 10
      background-color: #151515ee
      border: 1 #333333
      
      // Rewards panel
      Panel
        id: rewardsPanel
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 180
        margin: 10
        background-color: #101010ee
        border: 1 #444444
        
        Label
          id: rewardsTitle
          !text: tr('Base Rewards')
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 5
          color: #ffcc00
          font: verdana-11px-rounded
        
        // Único painel para todas as recompensas
        Panel
          id: rewardsContentPanel
          anchors.top: rewardsTitle.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          margin-top: 10
          margin-left: 10
          margin-right: 10
          
          // Experiência diretamente sem ícone
          Label
            id: experienceLabel
            !text: tr('Experience: 1000')
            anchors.top: parent.top
            anchors.left: parent.left
            margin-top: 5
            color: #00ccff
            font: verdana-11px-rounded
            text-auto-resize: true
            
          // Gold diretamente sem ícone
          Label
            id: goldLabel
            !text: tr('Gold: 500')
            anchors.top: experienceLabel.bottom
            anchors.left: parent.left
            margin-top: 10
            color: #ffcc00
            font: verdana-11px-rounded
            text-auto-resize: true
            
          // Pontos de task diretamente sem ícone
          Label
            id: taskPointsLabel
            !text: tr('Task Points: 1')
            anchors.top: goldLabel.bottom
            anchors.left: parent.left
            margin-top: 10
            color: #00ff00
            font: verdana-11px-rounded
            text-auto-resize: true
          
          // Items label
          Label
            id: itemsHeader
            !text: tr('Items:')
            anchors.top: taskPointsLabel.bottom
            anchors.left: parent.left
            margin-top: 15
            color: #ffffff
            font: verdana-11px-rounded
            
          // Items content
          Label
            id: itemsLabel
            !text: tr('1x burning heart')
            anchors.top: itemsHeader.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 5
            margin-left: 10
            color: #ffffff
            font: verdana-11px-rounded
            text-wrap: true
            height: 70
          
        // Labels escondidos para manter compatibilidade
        Label
          id: accessLabel
          anchors.top: parent.top
          anchors.left: parent.left
          visible: false
          
        Label
          id: teleportLabel
          anchors.top: parent.top
          anchors.left: parent.left
          visible: false
      
      // Monsters panel - simplified version with fixed icons
      Panel
        id: monstersDisplayPanel
        anchors.top: rewardsPanel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 100
        margin-top: 10
        background-color: #101010ee
        border: 1 #444444
        
        Label
          !text: tr('Monsters')
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 5
          color: #ffcc00
          font: verdana-11px-rounded
        
        // First monster with name
        Panel
          id: monster1Panel
          anchors.left: parent.left
          anchors.top: prev.bottom
          anchors.bottom: parent.bottom
          width: 85
          margin-left: 20
          margin-top: 5
          
          UIWidget
            id: monster1Icon
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 3
            size: 32 32
            image-source: /modules/images/game/creatures/monsters/rat
            phantom: true
            
          Label
            id: monster1Name
            !text: tr('Troll')
            anchors.top: monster1Icon.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 3
            text-auto-resize: false
            text-wrap: true
            width: 80
            height: 30
            text-align: center
            font: verdana-11px-rounded
            color: #ffffff
          
        // Second monster with name
        Panel
          id: monster2Panel
          anchors.left: monster1Panel.right
          anchors.top: monster1Panel.top
          anchors.bottom: parent.bottom
          width: 85
          margin-left: 10
          
          UIWidget
            id: monster2Icon
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 3
            size: 32 32
            image-source: /modules/images/game/creatures/monsters/rat
            phantom: true
            
          Label
            id: monster2Name
            !text: tr('Orc Spearman')
            anchors.top: monster2Icon.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 3
            text-auto-resize: false
            text-wrap: true
            width: 80
            height: 30
            text-align: center
            font: verdana-11px-rounded
            color: #ffffff
          
        // Third monster with name
        Panel
          id: monster3Panel
          anchors.left: monster2Panel.right
          anchors.top: monster1Panel.top
          anchors.bottom: parent.bottom
          width: 85
          margin-left: 10
          
          UIWidget
            id: monster3Icon
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 3
            size: 32 32
            image-source: /modules/images/game/creatures/monsters/rat
            phantom: true
            
          Label
            id: monster3Name
            !text: tr('Orc Warrior')
            anchors.top: monster3Icon.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 3
            text-auto-resize: false
            text-wrap: true
            width: 80
            height: 30
            text-align: center
            font: verdana-11px-rounded
            color: #ffffff
      
      // Kills panel with progress bar
      Panel
        id: killsPanel
        anchors.top: monstersDisplayPanel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 110
        margin-top: 10
        background-color: #101010ee
        border: 1 #444444
        
        Label
          !text: tr('Required Kills')
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 5
          color: #ffcc00
          font: verdana-11px-rounded-bold
        
        // Single kill requirement value
        Label
          id: killsRequired
          !text: tr('25')
          anchors.top: prev.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 10
          text-align: center
          font: verdana-11px-rounded-bold
          color: #ffffff
          width: 160
          height: 30
          text-auto-resize: true
        
        // Progress bar
        ProgressBar
          id: killsProgress
          anchors.top: killsRequired.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 15
          margin-left: 20
          margin-right: 20
          margin-top: 10
          background-color: #333333
        
        Button
          id: startTaskButton
          !text: tr('Start Task')
          width: 120
          height: 30
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.bottom: parent.bottom
          margin-bottom: 10
          @onClick: modules.game_tasks.startTask()