TaskLabel < Label
  font: verdana-11px-monochrome
  focusable: true
  height: 50
  margin-top: 2
  margin-bottom: 2
  padding: 5
  background-color: alpha
  icon-size: 40 40
  icon-rect: 0 0 40 40
  icon-offset: 5 5
  text-offset: 50 15
  color: #aaaaaa

  $focus:
    background-color: #444444
    color: #ffffff

  $!focus:
    background-color: alpha

  $recommended:
    text-color: #00ff00

  $daily:
    text-color: #ffcc00

TaskSectionHeader < Label
  height: 25
  background-color: #222222
  text-align: center
  font: verdana-11px-rounded
  color: #ffcc00
  margin-top: 5
  margin-bottom: 5
  border: 1 #444444

TaskContainer < Panel
  layout: verticalBox
  layout-spacing: 2
  padding: 2

TaskPanel < UIWidget
  height: 60
  background-color: alpha
  padding: 5
  margin-bottom: 2
  
  UIWidget
    id: taskIcon
    size: 48 48
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    
  Label
    id: taskName
    anchors.left: taskIcon.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    text-align: left
    font: verdana-11px-monochrome
    color: #cccccc
    
  $hover:
    background-color: #444444
    
  $focus:
    background-color: #555555
    
  $selected:
    background-color: #666666
    
TaskContainer < ScrollablePanel
  layout:
    type: verticalBox
    spacing: 2

TasksWindow < MainWindow
  id: tasksWindow
  !text: tr('Tasks')
  size: 800 600
  @onEscape: self:hide()
  @onEnter: self:hide()
  
  // Painel principal com gradiente
  Panel
    id: mainPanel
    anchors.fill: parent
    margin: 3
    background-color: #20202088
    border: 1 #333333
    
    // Campo de busca estilizado
    TextEdit
      id: searchText
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      margin-left: 10
      margin-right: 10
      height: 25
      !text: tr('Search by monster name')
      background-color: #111111
      color: #aaaaaa
      font: verdana-11px-rounded
      padding: 5
      border: 1 #444444
      @onTextChange: modules.game_tasks.filterTasks()
      
    // Lista de tasks com scroll
    Panel
      id: taskListPanel
      anchors.top: searchText.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-top: 10
      margin-left: 10
      width: 350
      background-color: #15151588
      border: 1 #333333
      
      ScrollablePanel
        id: taskList
        anchors.fill: parent
        margin: 2
        vertical-scrollbar: taskListScrollBar
        layout:
          type: verticalBox
          spacing: 2
          
      VerticalScrollBar
        id: taskListScrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        step: 14
        pixels-scroll: true
      
    // Painel de detalhes
    Panel
      id: detailsPanel
      anchors.top: searchText.bottom
      anchors.left: taskListPanel.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 10
      background-color: #15151588
      border: 1 #333333
      
      // Painel de recompensas
      Panel
        id: rewardsPanel
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 150
        margin: 10
        background-color: #10101088
        border: 1 #444444
        
        Label
          !text: tr('Base Rewards')
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 5
          color: #ffcc00
          font: verdana-11px-rounded
          
        Label
          id: taskPointsLabel
          !text: tr('Tasks Points: 0')
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 10
          margin-left: 10
          color: #00ff00
          font: verdana-11px-rounded
          
        Label
          id: experienceLabel
          !text: tr('Experience: 0')
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 5
          margin-left: 10
          color: #ffffff
          font: verdana-11px-rounded
          
        Label
          id: goldLabel
          !text: tr('Gold: 0')
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 5
          margin-left: 10
          color: #ffcc00
          font: verdana-11px-rounded
          
        Label
          id: itemsLabel
          !text: tr('Items: None')
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 5
          margin-left: 10
          color: #ffffff
          font: verdana-11px-rounded
          
        Label
          id: accessLabel
          !text: tr('Access: None')
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 5
          margin-left: 10
          color: #ffffff
          font: verdana-11px-rounded
          
        Label
          id: teleportLabel
          !text: tr('Teleport: None')
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 5
          margin-left: 10
          color: #ffffff
          font: verdana-11px-rounded
          
      // Painel de kills
      Panel
        id: killsPanel
        anchors.top: rewardsPanel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 100
        margin-top: 10
        background-color: #10101088
        border: 1 #444444
        
        Label
          !text: tr('Required Kills')
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 5
          color: #ffcc00
          font: verdana-11px-rounded
        
        Label
          id: killsRequired
          !text: tr('25')
          anchors.top: prev.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 10
          font: verdana-11px-rounded
          
        ProgressBar
          id: killsProgress
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: bonusLabel.top
          height: 15
          margin-left: 10
          margin-right: 10
          margin-bottom: 10
          background-color: #00000066
          
        Label
          id: bonusLabel
          !text: tr('+10% Experience (today)')
          anchors.bottom: parent.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-bottom: 10
          font: verdana-11px-rounded
          color: #00ff00
          
        Button
          id: startTaskButton
          !text: tr('Start Task')
          width: 120
          height: 30
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.bottom: parent.bottom
          margin-bottom: 10
          @onClick: modules.game_tasks.startTask()