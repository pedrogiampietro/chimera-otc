MainWindow
  id: tasksWindow
  !text: tr('Tasks')
  size: 550 400
  @onEscape: modules.game_tasks.hide()
  draggable: true
  
  Label
    id: headerLabel
    !text: tr('Monster Tasks')
    text-align: center
    text-auto-resize: true
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10
    font: verdana-11px-rounded
    color: #FFD700

  TextEdit
    id: searchText
    anchors.top: headerLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    margin-top: 10
    margin-left: 10
    margin-right: 5
    placeholder-text: 'Search by monster name'

  Panel
    id: monsterList
    anchors.top: searchText.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    anchors.right: parent.horizontalCenter
    margin-top: 10
    margin-left: 10
    margin-right: 5
    margin-bottom: 10
    layout: verticalBox
    background-color: #00000070
    border-width: 1
    border-color: #303030

  Panel
    id: taskInfo
    anchors.top: headerLabel.bottom
    anchors.right: parent.right
    anchors.bottom: startButton.top
    anchors.left: parent.horizontalCenter
    margin-top: 10
    margin-right: 10
    margin-left: 5
    margin-bottom: 10
    layout: verticalBox
    
    Panel
      id: baseRewardsPanel
      height: 120
      layout: verticalBox
      
      Label
        !text: tr('Base Rewards')
        text-align: center
        background-color: #00000040
        margin-bottom: 5
        font: verdana-11px-rounded
        color: #FFD700
        
      Label
        id: tasksPoints
        !text: tr('Tasks Points: 0')
        margin-left: 5
        
      Label
        id: experience
        !text: tr('Experience: 0')
        margin-left: 5
        
      Label
        id: gold
        !text: tr('Gold: 0')
        margin-left: 5
        
      Label
        id: itemReward
        !text: tr('Item: None')
        margin-left: 5
        
      Label
        id: otherRewards
        !text: tr('Other: None')
        margin-left: 5
    
    Panel
      id: monstersPanel
      height: 120
      layout: verticalBox
      margin-top: 10
      
      Label
        !text: tr('Monsters')
        text-align: center
        background-color: #00000040
        margin-bottom: 5
        font: verdana-11px-rounded
        color: #FFD700
      
      Panel
        id: monsterImagesPanel
        height: 50
        margin-bottom: 5
      
      HorizontalScrollBar
        id: monstersScroll
        height: 15
        step: 10
    
    Panel
      id: requiredKillsPanel
      height: 80
      layout: verticalBox
      margin-top: 10
      
      Label
        !text: tr('Required Kills')
        text-align: center
        background-color: #00000040
        margin-bottom: 5
        font: verdana-11px-rounded
        color: #FFD700
      
      Panel
        height: 40
        
        Label
          id: kill1
          !text: tr('100')
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 50
          
        Label
          id: kill2
          !text: tr('100')
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.verticalCenter: parent.verticalCenter
          
        Label
          id: kill3
          !text: tr('5000')
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 50

  Button
    id: startButton
    !text: tr('Start Task')
    width: 100
    height: 30
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 10
    margin-bottom: 10
    @onClick: modules.game_tasks.startTask()
    
  Button
    id: closeButton
    !text: tr('Close')
    width: 80
    height: 30
    anchors.right: startButton.left
    anchors.bottom: parent.bottom
    margin-right: 10
    margin-bottom: 10
    @onClick: modules.game_tasks.hide()
    
  Button
    id: testDataButton
    !text: tr('Load Test Data')
    width: 110
    height: 30
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 10
    margin-bottom: 10
    @onClick: modules.game_tasks.loadTestData() 